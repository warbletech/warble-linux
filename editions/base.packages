# Shared base packages (Arch official repos only — no AUR names).
# Used by every edition. Real mkarchiso builds require these names to resolve.

# Kernel / archiso (live boot needs mkinitcpio-archiso hooks; see
# profile/airootfs/etc/mkinitcpio.conf.d/archiso.conf)
#
# VM-first: no linux-firmware (~half the minimal ISO). VMs (QEMU/KVM,
# VirtualBox, Hyper-V, VMware) need no device firmware; bare-metal Wi-Fi/GPUs
# that need firmware won't work. No PXE (nfs/nbd hooks), no GRUB (UEFI boots via
# systemd-boot, BIOS via syslinux).
base
linux
amd-ucode
intel-ucode
mkinitcpio
mkinitcpio-archiso
squashfs-tools
syslinux
edk2-shell
memtest86+
memtest86+-efi

# Networking / admin
nftables
iproute2
iputils
dhcpcd
networkmanager
sudo
dialog
git
curl
wget
tar
unzip
which
less
vim
nano

# GUI (live sandbox)
openbox
feh
xorg-server
xorg-xinit
xterm
firefox
ttf-dejavu
terminator
