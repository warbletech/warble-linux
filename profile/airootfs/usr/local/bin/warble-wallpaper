#!/bin/sh
# Set the Warble Linux wallpaper for this edition (read from /etc/warble-release).
#   warble-wallpaper            dark wallpaper for this edition
#   WARBLE_THEME=light warble-wallpaper
#   warble-wallpaper <file>     any image
dir=/usr/share/backgrounds/warble
variant=minimal
[ -r /etc/warble-release ] && variant=$(sed -n 's/^VARIANT=//p' /etc/warble-release)
theme=${WARBLE_THEME:-dark}
img=${1:-$dir/warble-linux-minimal-${theme}-1920x1080.png}
[ -f "$img" ] || img=$dir/warble-linux-minimal-dark-1920x1080.png
exec feh --no-fehbg --bg-fill "$img"
